[Unit]
Description=KRunner Bitwarden runner (rbw backend, Rust)
# The runner spawns rbw, whose agent prompts via pinentry and needs the
# session's DISPLAY / WAYLAND_DISPLAY. Those reach the systemd user
# manager only when the graphical session starts, so the runner must not
# start before it: an earlier start snapshots an environment without
# them, and every rbw-agent started from here then fails to prompt.
After=dbus.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.kde.krunner.bitwarden
ExecStart=%h/.local/share/krunner-rustwarden/krunner-rustwarden
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

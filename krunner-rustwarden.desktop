[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=Plasma/Runner
Name=Bitwarden (rbw)
Comment=Search Bitwarden vault via rbw and copy credentials
Icon=dialog-password
X-KDE-PluginInfo-Name=bitwarden
X-KDE-PluginInfo-Version=0.3.0
X-KDE-PluginInfo-Author=Christian McHugh
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-Copyright=Copyright (c) 2026 Christian McHugh
X-KDE-PluginInfo-Website=https://github.com/mchugh19/krunner-rustwarden
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.kde.krunner.bitwarden
X-Plasma-DBusRunner-Path=/runner
X-KDE-ConfigModule=kcm_plasmasearch
